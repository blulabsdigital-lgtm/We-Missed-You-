# Public URL the app is served from (used for Twilio + Stripe callbacks)
PUBLIC_URL=https://wemissedyou.example.com
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/wmy.db

# Twilio (leave blank = DEV mode, messages are logged not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_COUNTRY=GB
# UK numbers need a regulatory bundle + address in Twilio
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
# Your approved WhatsApp sender (E.164), shared by all customers
TWILIO_WHATSAPP_FROM=

# Stripe (leave blank = DEV mode, pay button unlocks for free)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTH=
STRIPE_PRICE_SOLO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_PRICE_SEAT_MONTH=
STRIPE_PRICE_SEAT_YEAR=

# Password reset + team invite emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=We Missed You <hello@yourdomain.co.uk>

# Plan limits (texts per month) and trial
SOLO_TEXTS=150
TEAM_TEXTS=400
SEAT_TEXTS=80
TRIAL_DAYS=7

# Look: classic | glass-a | glass-b | glass-c
THEME=glass-c

# Optional
RING_SECONDS=20
DEFAULT_COUNTRY_CODE=44
